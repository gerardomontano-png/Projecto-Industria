# Configuración de la base de datos (J02)
# Copia este archivo como .env y ajusta los valores. NO subas tu .env al repositorio.

# Desarrollo local (por defecto): SQLite en un archivo dentro de ./data
DB_URL=sqlite+pysqlite:///./data/vision.db

# Producción: PostgreSQL. La contraseña va en la URL; mantén el .env fuera de git.
# DB_URL=postgresql+psycopg://usuario:contrasena@servidor:5432/vision

# Registrar en consola el SQL ejecutado (solo para depurar)
DB_ECHO=false

# Pool de conexiones (se ignora en SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
